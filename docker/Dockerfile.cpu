# linus without the GPU backend, for cluster jobs on CPUs.
#
# The build stage is shared with Dockerfile.gpu: its first lines repeat Dockerfile.gpu's build
# stage exactly, so after a GPU build of the same commit (docker/build.sh all) Docker's layer
# cache supplies them, and only the CPU variant is compiled, on that stage's target directory
# (the dependencies and libxc are not built again). Built alone, the stage builds both variants.
# Keep the two in step: docker/build.sh checks that they match.
FROM rust:1.99.0-bookworm AS build
RUN apt-get update && apt-get install -y --no-install-recommends cmake python3-venv \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
ENV LINUS_DIST=1
RUN cargo build --profile dist -p linus-cli --features gpu
RUN python3 -m venv /opt/maturin && /opt/maturin/bin/pip install --no-cache-dir "maturin>=1.9,<2" \
 && python3 tools/cuda13_distribution.py \
 && (cd crates/linus-py && /opt/maturin/bin/maturin build --profile dist --strip --features gpu -o /wheels) \
 && python3 tools/cuda13_distribution.py --undo
RUN mkdir -p /out/share/linus && cp -rL data/basis /out/share/linus/basis
# the CPU variant (no `gpu` feature)
RUN cargo build --profile dist -p linus-cli && mkdir -p /out/cpu && cp target/dist/linus /out/cpu/linus
RUN cd crates/linus-py && /opt/maturin/bin/maturin build --profile dist --strip -o /out/cpu/wheels

FROM python:3.12.12-slim-bookworm
COPY --from=build /out/cpu/linus /usr/local/bin/linus
COPY --from=build /out/share/linus /usr/local/share/linus
ENV LINUS_BASIS_DIR=/usr/local/share/linus/basis
COPY --from=build /out/cpu/wheels /tmp/wheels
RUN pip install --no-cache-dir "$(ls /tmp/wheels/afh_linus-*.whl)" qccompute==0.23.0 qcdata==0.24.0 \
 && rm -rf /tmp/wheels \
 && printf '3\n\nO 0 0 0.1173\nH 0 0.7572 -0.4692\nH 0 -0.7572 -0.4692\n' > /tmp/w.xyz \
 && linus /tmp/w.xyz --method hf --basis def2-svp --json | python3 -c "import json,sys; r=json.load(sys.stdin); assert r['success']; print('linus ok (cpu)', r['energy'])" \
 && python3 -c "import linus, qccompute" \
 && rm /tmp/w.xyz
